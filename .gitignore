*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ==========================================
# 2. DEPENDENCIAS DE NODE & VITE (Frontend)
# ==========================================
node_modules/
frontend/node_modules/

